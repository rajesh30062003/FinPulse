# Environment Configuration for FinPulse - Smart Personal Finance System

# GEMINI_API_KEY: Optional AI assistant key if needed
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Render Backend URL for Vercel Frontend deployment
# (Set this in your Vercel Project Settings > Environment Variables)
# e.g., VITE_API_URL="https://your-backend.onrender.com"
VITE_API_URL="http://localhost:3000"

# CLIENT_URL: Frontend origin allowed by backend CORS (e.g., https://your-app.vercel.app)
CLIENT_URL="http://localhost:3000"

# APP_URL: Current hosting URL for email links and callbacks
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Atlas connection string
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/finpulse?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/finpulse"

# JWT_SECRET: Strong secret for JWT token signing
JWT_SECRET="finpulse_super_secure_jwt_secret_key_2026_xyz"

# SMTP Configuration for automated emails (verification, password reset, bill reminders)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@finpulse.example"
SMTP_PASS="your-app-password"
EMAIL_FROM="FinPulse Security <alerts@finpulse.example>"

# Server Port
PORT=3000
